 "monuments": [
  {
   "id": "forum-of-trajan",
   "name": "Forum of Trajan",
   "latin": "Forum Traiani",
   "lon": 12.4853,
   "lat": 41.8946,
   "years": "c. 106–112",
   "kind": "trajanic",
   "summary": "The largest of the imperial forums, a great colonnaded square with a gilded equestrian statue of Trajan at its centre. It was built with the spoils of the Dacian Wars and dedicated in 112."
  },
  {
   "id": "basilica-ulpia",
   "name": "Basilica Ulpia",
   "latin": "Basilica Ulpia",
   "lon": 12.4848,
   "lat": 41.8954,
   "years": "c. 106–112",
   "kind": "trajanic",
   "summary": "A vast hall for law courts and business across the north-west end of the Forum. It took its name from Trajan's family name, Ulpius."
  },
  {
   "id": "trajans-column",
   "name": "Trajan's Column",
   "latin": "Columna Traiani",
   "lon": 12.4842,
   "lat": 41.8958,
   "years": "113",
   "kind": "trajanic",
   "summary": "A 30 m marble column carved with a spiral frieze of the Dacian Wars, dedicated in May 113 between two libraries behind the Basilica Ulpia. Trajan's ashes were later placed in its base."
  },
  {
   "id": "markets-of-trajan",
   "name": "Markets of Trajan",
   "latin": "Mercatus Traiani (modern name)",
   "lon": 12.4862,
   "lat": 41.8957,
   "years": "c. 100–110",
   "kind": "trajanic",
   "summary": "A brick complex of shops, halls and offices climbing the Quirinal slope behind the Forum. Much of it still stands and houses a museum."
  },
  {
   "id": "baths-of-trajan",
   "name": "Baths of Trajan",
   "latin": "Thermae Traiani",
   "lon": 12.4963,
   "lat": 41.8922,
   "years": "c. 104–109",
   "kind": "trajanic",
   "summary": "Huge public baths on the Oppian Hill, built over part of Nero's Golden House and opened in 109. Only fragments, such as exedrae in the Colle Oppio park, survive."
  },
  {
   "id": "temple-divine-trajan",
   "name": "Temple of the Deified Trajan",
   "latin": "Templum Divi Traiani",
   "lon": 12.4837,
   "lat": 41.8963,
   "years": "after 117 (under Hadrian)",
   "kind": "trajanic",
   "summary": "Hadrian built a temple to Trajan and his wife Plotina after their deaths. It is traditionally placed just north of the Column (around today's Palazzo Valentini), but it has never been securely found and its site is still debated.",
   "approximate": true
  },
  {
   "id": "naumachia-traiana",
   "name": "Naumachia of Trajan",
   "latin": "Naumachia Traiana",
   "lon": 12.462,
   "lat": 41.905,
   "years": "109",
   "kind": "trajanic",
   "summary": "An artificial basin for staged sea battles, inaugurated in 109, on the Vatican plain west of the Tiber. Its exact site is uncertain; remains found north-west of Castel Sant'Angelo (Hadrian's Mausoleum) are usually identified with it.",
   "approximate": true
  },
  {
   "id": "aqua-traiana-terminus",
   "name": "Aqua Traiana (end of the aqueduct)",
   "latin": "Aqua Traiana",
   "lon": 12.4641,
   "lat": 41.8886,
   "years": "109",
   "kind": "trajanic",
   "summary": "Trajan's aqueduct arrived on the Janiculum Hill, where its water drove mills before supplying the district across the Tiber. It was opened in June 109."
  },
  {
   "id": "colosseum",
   "name": "Colosseum",
   "latin": "Amphitheatrum Flavium",
   "lon": 12.4922,
   "lat": 41.8903,
   "years": "70s–80",
   "kind": "landmark",
   "summary": "The Flavian Amphitheatre, finished in AD 80, about 20 years before Trajan came to power. Trajan celebrated his Dacian victory with games said to have lasted 123 days, many of them held here."
  },
  {
   "id": "capitoline",
   "name": "Capitoline Hill",
   "latin": "Capitolium",
   "lon": 12.4831,
   "lat": 41.8933,
   "years": null,
   "kind": "landmark",
   "summary": "The religious heart of Rome, crowned by the Temple of Jupiter Best and Greatest. The inscription on Trajan's Column says a hill was cut away to make room for his Forum, traditionally the ridge that joined the Capitoline to the Quirinal."
  },
  {
   "id": "forum-romanum",
   "name": "Roman Forum",
   "latin": "Forum Romanum",
   "lon": 12.4852,
   "lat": 41.8922,
   "years": null,
   "kind": "landmark",
   "summary": "The old civic centre of Rome, crowded with temples, law courts and the Senate House. The imperial forums, including Trajan's, were built beside it as it ran out of space."
  },
  {
   "id": "tiber-island",
   "name": "Tiber Island",
   "latin": "Insula Tiberina",
   "lon": 12.4772,
   "lat": 41.8908,
   "years": null,
   "kind": "landmark",
   "summary": "A small island in the Tiber, home to a temple of Aesculapius, the god of healing. It helps orient the river bend below the Capitoline."
  }
 ],
