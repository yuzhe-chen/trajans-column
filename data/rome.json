 "monuments": [
  {
   "id": "forum-of-trajan",
   "name": "Forum of Trajan",
   "latin": "Forum Traiani",
   "lon": 12.4853,
   "lat": 41.8946,
   "years": "c. 106–112",
   "kind": "trajanic",
   "summary": "The biggest of the imperial forums, a huge colonnaded square with a gilded statue of Trajan on horseback in the middle. It was paid for with loot from the Dacian Wars and dedicated in 112."
  },
  {
   "id": "basilica-ulpia",
   "name": "Basilica Ulpia",
   "latin": "Basilica Ulpia",
   "lon": 12.4848,
   "lat": 41.8954,
   "years": "c. 106–112",
   "kind": "trajanic",
   "summary": "A vast hall for law courts and business across the end of the forum. It was named after Trajan’s family, the Ulpii."
  },
  {
   "id": "trajans-column",
   "name": "Trajan's Column",
   "latin": "Columna Traiani",
   "lon": 12.4842,
   "lat": 41.8958,
   "years": "113",
   "kind": "trajanic",
   "summary": "The column itself, carved with the Dacian Wars and dedicated in May 113. It stood between two libraries behind the Basilica Ulpia, and Trajan’s ashes were later put in its base."
  },
  {
   "id": "markets-of-trajan",
   "name": "Markets of Trajan",
   "latin": "Mercatus Traiani (modern name)",
   "lon": 12.4862,
   "lat": 41.8957,
   "years": "c. 100–110",
   "kind": "trajanic",
   "summary": "A brick complex of shops, halls and offices climbing the Quirinal Hill behind the forum. A lot of it is still standing, and today it’s a museum."
  },
  {
   "id": "baths-of-trajan",
   "name": "Baths of Trajan",
   "latin": "Thermae Traiani",
   "lon": 12.4963,
   "lat": 41.8922,
   "years": "c. 104–109",
   "kind": "trajanic",
   "summary": "Huge public baths on the Oppian Hill, built over part of Nero’s Golden House and opened in 109. Only pieces survive, like the curved walls in the Colle Oppio park."
  },
  {
   "id": "temple-divine-trajan",
   "name": "Temple of the Deified Trajan",
   "latin": "Templum Divi Traiani",
   "lon": 12.4837,
   "lat": 41.8963,
   "years": "after 117 (under Hadrian)",
   "kind": "trajanic",
   "summary": "After Trajan and his wife Plotina died, Hadrian built a temple to them. It’s usually placed just north of the column, near today’s Palazzo Valentini, but nobody has found it for certain.",
   "approximate": true
  },
  {
   "id": "naumachia-traiana",
   "name": "Naumachia of Trajan",
   "latin": "Naumachia Traiana",
   "lon": 12.462,
   "lat": 41.905,
   "years": "109",
   "kind": "trajanic",
   "summary": "A man-made lake for staging sea battles, opened in 109 on the Vatican side of the Tiber. Its exact spot is uncertain, but remains north-west of Castel Sant’Angelo are usually thought to be it.",
   "approximate": true
  },
  {
   "id": "aqua-traiana-terminus",
   "name": "Aqua Traiana (end of the aqueduct)",
   "latin": "Aqua Traiana",
   "lon": 12.4641,
   "lat": 41.8886,
   "years": "109",
   "kind": "trajanic",
   "summary": "This is where Trajan’s aqueduct arrived, on the Janiculum Hill. Its water turned mills here before supplying the neighbourhood across the Tiber. It opened in June 109."
  },
  {
   "id": "colosseum",
   "name": "Colosseum",
   "latin": "Amphitheatrum Flavium",
   "lon": 12.4922,
   "lat": 41.8903,
   "years": "70s–80",
   "kind": "landmark",
   "summary": "The Flavian Amphitheatre, finished in AD 80, about twenty years before Trajan became emperor. He celebrated beating Dacia with games said to have lasted 123 days, and a lot of them happened here."
  },
  {
   "id": "capitoline",
   "name": "Capitoline Hill",
   "latin": "Capitolium",
   "lon": 12.4831,
   "lat": 41.8933,
   "years": null,
   "kind": "landmark",
   "summary": "The religious heart of Rome, with the Temple of Jupiter Best and Greatest on top. The inscription on the column says a hill was cut away to make room for the forum, and that’s usually taken to be the ridge between the Capitoline and the Quirinal."
  },
  {
   "id": "forum-romanum",
   "name": "Roman Forum",
   "latin": "Forum Romanum",
   "lon": 12.4852,
   "lat": 41.8922,
   "years": null,
   "kind": "landmark",
   "summary": "Rome’s old city centre, packed with temples, law courts and the Senate House. When it ran out of room, emperors built new forums beside it, and Trajan’s was the last."
  },
  {
   "id": "tiber-island",
   "name": "Tiber Island",
   "latin": "Insula Tiberina",
   "lon": 12.4772,
   "lat": 41.8908,
   "years": null,
   "kind": "landmark",
   "summary": "A small island in the Tiber with a temple to Aesculapius, the god of healing. It’s a handy landmark for the bend in the river below the Capitoline."
  }
 ],
